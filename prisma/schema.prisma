// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// IDENTITY & ACCESS
// -----------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(VIEWER)
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  loginAttempts LoginAttempt[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  location  String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
}

// -----------------------------------------------------------------------------
// SITE CONFIG
// -----------------------------------------------------------------------------
model SiteSetting {
  id            String   @id @default(cuid())
  nameFa        String
  nameEn        String?
  logoId        String?
  faviconId     String?
  taglineFa     String?
  taglineEn     String?
  activeTheme   String?  @default("petboss-luxury-dark")
  heroTitleFa   String?
  heroTitleEn   String?
  heroSubtitleFa String?
  heroSubtitleEn String?
  addresses     Json?
  geo           Json?
  emails        Json?
  phones        Json?
  workingHours  Json?
  holidayNotice Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

enum SocialPlatform {
  INSTAGRAM
  TELEGRAM
  WHATSAPP
  FACEBOOK
  X
  LINKEDIN
  YOUTUBE
  APARAT
  TIKTOK
  PINTEREST
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform @unique
  url       String
  icon      String?
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([isActive, sortOrder])
}

model ContactChannel {
  id        String   @id @default(cuid())
  type      String
  value     String
  labelFa   String?
  labelEn   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model NavigationMenu {
  id        String     @id @default(cuid())
  name      String     @unique
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id        String         @id @default(cuid())
  menuId    String
  parentId  String?
  labelFa   String
  labelEn   String?
  url       String
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  menu     NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?       @relation("MenuHierarchy", fields: [parentId], references: [id])
  children MenuItem[]      @relation("MenuHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Redirect {
  id         String   @id @default(cuid())
  source     String   @unique
  destination String
  permanent  Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([source])
}

model SeoSetting {
  id              String   @id @default(cuid())
  gscVerification String?
  ga4Id           String?
  gtmId           String?
  googleAdsId     String?
  bingId          String?
  enamadCode      String?
  samandehiCode   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalyticsSetting {
  id        String   @id @default(cuid())
  metaPixel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceMode {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(false)
  messageFa String?
  messageEn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  titleFa   String
  titleEn   String?
  link      String?
  isActive  Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

// -----------------------------------------------------------------------------
// THEMING
// -----------------------------------------------------------------------------
model Theme {
  id        String   @id @default(cuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemePreset {
  id        String   @id @default(cuid())
  name      String   @unique
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FontSetting {
  id        String   @id @default(cuid())
  primary   String   @default("Vazirmatn")
  secondary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserThemePreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  preference String   @default("system") // dark, light, system
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// CLINIC CONTENT
// -----------------------------------------------------------------------------
model Division {
  id                 String    @id @default(cuid())
  slugFa             String    @unique
  slugEn             String?   @unique
  nameFa             String
  nameEn             String?
  descriptionFa      String?
  descriptionEn      String?
  metaTitleFa        String?
  metaTitleEn        String?
  metaDescriptionFa  String?
  metaDescriptionEn  String?
  ogImageId          String?
  canonicalUrl       String?
  noindex            Boolean   @default(false)
  priority           Float     @default(0.8)
  changefreq         String    @default("monthly")
  focusKeyword       String?
  jsonLdOverride     Json?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  services Service[]

  @@index([slugFa])
  @@index([isActive, sortOrder])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  nameFa    String
  nameEn    String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

enum PriceDisplayMode {
  RANGE
  FROM
  ON_REQUEST
}

model Service {
  id                 String           @id @default(cuid())
  divisionId         String
  slugFa             String           @unique
  slugEn             String?          @unique
  nameFa             String
  nameEn             String?
  descriptionFa      String?
  descriptionEn      String?
  benefitsFa         String?
  benefitsEn         String?
  durationFa         String?
  durationEn         String?
  priceDisplayMode   PriceDisplayMode @default(ON_REQUEST)
  priceFrom          Int?
  priceTo            Int?
  priceNoteFa        String?
  priceNoteEn        String?
  metaTitleFa        String?
  metaTitleEn        String?
  metaDescriptionFa  String?
  metaDescriptionEn  String?
  ogImageId          String?
  canonicalUrl       String?
  noindex            Boolean   @default(false)
  priority           Float     @default(0.8)
  changefreq         String    @default("monthly")
  focusKeyword       String?
  jsonLdOverride     Json?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  division Division @relation(fields: [divisionId], references: [id])
  relatedServices Service[] @relation("RelatedServices")
  relatedTo       Service[] @relation("RelatedServices")
  faqs            Faq[]

  @@index([divisionId])
  @@index([slugFa])
  @@index([isActive, sortOrder])
}

model StaffMember {
  id          String    @id @default(cuid())
  nameFa      String
  nameEn      String?
  titleFa     String?
  titleEn     String?
  specialtyFa String?
  specialtyEn String?
  bioFa       String?
  bioEn       String?
  photoId     String?
  licenseNo   String?
  socials     Json?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isActive, sortOrder])
}

model Specialty {
  id        String    @id @default(cuid())
  nameFa    String
  nameEn    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model WorkingHour {
  id        String   @id @default(cuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certificate {
  id        String    @id @default(cuid())
  nameFa    String
  nameEn    String?
  issuerFa  String?
  issuerEn  String?
  year      Int?
  imageId   String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Facility {
  id          String    @id @default(cuid())
  nameFa      String
  nameEn      String?
  descriptionFa String?
  descriptionEn String?
  imageId     String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

// -----------------------------------------------------------------------------
// ANIMALS
// -----------------------------------------------------------------------------
model Species {
  id        String    @id @default(cuid())
  nameFa    String
  nameEn    String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  breeds Breed[]
  products Product[] @relation("SpeciesProducts")
  // PHASE 2
  // pets Pet[]

  @@index([isActive, sortOrder])
}

model Breed {
  id                 String    @id @default(cuid())
  speciesId          String
  slugFa             String    @unique
  slugEn             String?   @unique
  nameFa             String
  nameEn             String?
  originFa           String?
  originEn           String?
  sizeFa             String?
  sizeEn             String?
  weightRangeFa      String?
  weightRangeEn      String?
  lifespanFa         String?
  lifespanEn         String?
  temperamentFa      String?
  temperamentEn      String?
  groomingNeedsFa    String?
  groomingNeedsEn    String?
  commonHealthIssuesFa String?
  commonHealthIssuesEn String?
  imageId            String?
  metaTitleFa        String?
  metaTitleEn        String?
  metaDescriptionFa  String?
  metaDescriptionEn  String?
  ogImageId          String?
  canonicalUrl       String?
  noindex            Boolean   @default(false)
  priority           Float     @default(0.7)
  changefreq         String    @default("monthly")
  focusKeyword       String?
  jsonLdOverride     Json?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  species Species @relation(fields: [speciesId], references: [id])
  careGuides BreedCareGuide[]
  // PHASE 2
  // pets Pet[]

  @@index([speciesId])
  @@index([slugFa])
  @@index([isActive, sortOrder])
}

model BreedCareGuide {
  id        String   @id @default(cuid())
  breedId   String
  titleFa   String
  titleEn   String?
  contentFa String?
  contentEn String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breed Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@index([breedId])
}

// -----------------------------------------------------------------------------
// SHOP (PHASE 1)
// -----------------------------------------------------------------------------
model ProductCategory {
  id                 String    @id @default(cuid())
  parentId           String?
  slugFa             String    @unique
  slugEn             String?   @unique
  nameFa             String
  nameEn             String?
  descriptionFa      String?
  descriptionEn      String?
  imageId            String?
  metaTitleFa        String?
  metaTitleEn        String?
  metaDescriptionFa  String?
  metaDescriptionEn  String?
  ogImageId          String?
  canonicalUrl       String?
  noindex            Boolean   @default(false)
  priority           Float     @default(0.8)
  changefreq         String    @default("weekly")
  focusKeyword       String?
  jsonLdOverride     Json?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([slugFa])
  @@index([isActive, sortOrder])
}

model Brand {
  id          String    @id @default(cuid())
  nameFa      String
  nameEn      String?
  slugFa      String    @unique
  slugEn      String?   @unique
  logoId      String?
  descriptionFa String?
  descriptionEn String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([slugFa])
  @@index([isActive, sortOrder])
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_BACKORDER
}

model Product {
  id                 String    @id @default(cuid())
  /// Days a pack typically lasts: drives repeat-purchase reminders
  consumeDays        Int?
  forSpecies         PetSpecies[]
  categoryId         String
  brandId            String?
  sku                String?   @unique
  /// EAN/UPC barcode (GTIN). Used in Product structured data and shopping feeds.
  barcode            String?
  /// True for food, treats, medicines etc. Admin is warned when such a product has no dated batch.
  tracksExpiry       Boolean   @default(false)
  slugFa             String    @unique
  slugEn             String?   @unique
  nameFa             String
  nameEn             String?
  shortDescFa        String?
  shortDescEn        String?
  descriptionFa      String?
  descriptionEn      String?
  price              Int
  comparePrice       Int?
  stockStatus        StockStatus @default(OUT_OF_STOCK)
  isPurchasable      Boolean   @default(false)
  weight             Float?
  dimensions         String?
  badges             Json?
  rating             Float     @default(0)
  reviewCount        Int       @default(0)
  metaTitleFa        String?
  metaTitleEn        String?
  metaDescriptionFa  String?
  metaDescriptionEn  String?
  ogImageId          String?
  canonicalUrl       String?
  noindex            Boolean   @default(false)
  priority           Float     @default(0.8)
  changefreq         String    @default("daily")
  focusKeyword       String?
  jsonLdOverride     Json?
  isActive           Boolean   @default(true)
  isFeatured         Boolean   @default(false)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?

  category ProductCategory @relation(fields: [categoryId], references: [id])
  brand    Brand?          @relation(fields: [brandId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  attributes ProductAttribute[]
  speciesCompatibility Species[] @relation("SpeciesProducts")
  inventory Inventory[]
  wishlistedBy Wishlist[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([slugFa])
  @@index([isFeatured])
  @@index([isActive, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageId   String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String?  @unique
  nameFa    String
  nameEn    String?
  price     Int?
  comparePrice Int?
  stockStatus StockStatus @default(OUT_OF_STOCK)
  isActive  Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  nameFa    String
  nameEn    String?
  valueFa   String
  valueEn   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A stock batch (lot) of a product. Each delivery is one row so that every
/// unit on the shelf has a known expiry date. The storefront shows the nearest
/// non-expired batch; expired batches are never sold (FEFO: first-expiry-first-out).
model Inventory {
  id          String    @id @default(cuid())
  productId   String
  quantity    Int       @default(0)
  location    String?
  batchNumber String?
  /// Manufacture date printed on the package (optional).
  manufactureDate DateTime?
  /// Expiry date printed on the package. Null for non-perishables (toys, bowls...).
  expiryDate  DateTime?
  receivedAt  DateTime  @default(now())
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([expiryDate])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// SHOP: customers, addresses, orders, payments
// -----------------------------------------------------------------------------

/// A shop customer. Identified by Iranian mobile number; signs in with an SMS one-time
/// code or with a password.
model Customer {
  id          String    @id @default(cuid())
  /// Normalised 09xxxxxxxxx
  phone       String    @unique
  firstName   String?
  lastName    String?
  /// Lower-case, unique. A second way to sign in besides the mobile number.
  email       String?   @unique
  isBlocked   Boolean   @default(false)
  /// Bumped on logout / password change: tokens signed with an older version stop working.
  sessionVersion Int    @default(0)
  /// scrypt hash ("scrypt$<salt>$<hash>"); null = the customer only uses SMS codes.
  passwordHash   String?
  /// Set when the customer proved they own the number (SMS code). A password account whose
  /// number was never verified loses its password when the real owner signs in by SMS,
  /// so nobody can keep an account by registering someone else's number first.
  phoneVerifiedAt DateTime?
  /// Wrong-password counter (reset on success or after the lock window) and time of the last attempt.
  failedLogins   Int       @default(0)
  lastFailedAt   DateTime?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Customer club / CRM
  birthDate   DateTime?
  gender      String?
  city        String?
  /// Admin-only CRM notes
  notes       String?
  tags        String[]
  referralCode String?  @unique
  referredById String?
  pointsBalance Int     @default(0)
  lifetimePoints Int    @default(0)
  tier        String    @default("BRONZE")
  marketingSmsConsent Boolean @default(false)
  marketingConsentAt DateTime?
  lastOrderAt DateTime?
  ordersCount Int       @default(0)
  totalSpent  Int       @default(0)
  createdByAdmin Boolean @default(false)
  source      String?

  pets      Pet[]
  visits    ServiceVisit[]
  pointsTransactions PointsTransaction[]
  rewardRedemptions  RewardRedemption[]
  cartSnapshot CartSnapshot?
  adminNotes AdminCustomerNote[]
  outbox     MessageOutbox[]

  addresses Address[]
  orders    Order[]
  coupons   Coupon[]
  couponRedemptions CouponRedemption[]
  groupMemberships  CustomerGroupMember[]
  marketingContacts MarketingContact[]

  @@index([createdAt])
  @@index([tier])
  @@index([lastOrderAt])
}

/// One-time login code sent by SMS. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

model Address {
  id             String    @id @default(cuid())
  customerId     String
  title          String?
  recipientName  String
  recipientPhone String
  province       String
  city           String
  /// Street, alley and landmarks
  addressLine    String
  plaque         String?
  unit           String?
  /// 10-digit Iranian postal code
  postalCode     String
  lat            Float?
  lng            Float?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  COD
}

model Order {
  id            String        @id @default(cuid())
  /// Human-friendly order number shown to customers, e.g. PB-1405-000123
  number        String        @unique
  customerId    String
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  /// All amounts in Toman
  subtotal      Int
  shippingFee   Int
  discount      Int           @default(0)
  /// Shipping fee waived by a free-shipping coupon (shippingFee is stored after this discount).
  shippingDiscount Int        @default(0)
  couponId      String?
  couponCode    String?
  total         Int
  /// Address snapshot at order time (addresses can be edited/deleted later)
  shipName      String
  shipPhone     String
  shipProvince  String
  shipCity      String
  shipAddress   String
  shipPostal    String
  customerNote  String?
  adminNote     String?
  trackingCode  String?
  stockAllocated Boolean      @default(false)
  /// Client-generated key (one per checkout visit) so a double submit returns the same order.
  idempotencyKey String?      @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]
  coupon   Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption CouponRedemption?

  @@index([customerId, createdAt])
  @@index([couponId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  /// Snapshots so the order stays correct if the product changes
  nameFa    String
  sku       String?
  slugFa    String?
  unitPrice Int
  quantity  Int
  lineTotal Int
  /// Units actually taken from stock: [{ "batchId": "...", "quantity": 2 }]. Null = legacy order
  /// (allocated before this column existed) or not allocated.
  allocations Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  provider   String
