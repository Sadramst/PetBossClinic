# Database (PostgreSQL 16)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST:-localhost}:5432/${DB_NAME:-petboss}?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Object Storage (Vultr)
STORAGE_ENDPOINT="https://ewr1.vultrobjects.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="petboss-media"
STORAGE_PUBLIC_URL="https://your-cdn-url.com"

# Admin User Setup
INITIAL_ADMIN_EMAIL="admin@petbossclinic.com"
INITIAL_ADMIN_PASSWORD="your-strong-temporary-password"

# Analytics (Managed via Admin Panel, but env vars can override)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Required in production: signs admin session cookies (openssl rand -hex 32)
# AUTH_SECRET is listed above; production refuses to start admin sessions without it.
DIRECT_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST:-localhost}:5432/${DB_NAME:-petboss}?schema=public"

# Protects /api/cron/expiry (Vercel Cron sends it automatically)
CRON_SECRET=""

# Optional fallbacks; normally set in Admin > Settings > Google & SEO
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ── Shop: customer login by SMS code ─────────────────────────────────────────
# "kavenegar" or "smsir". Unset = development only (code printed to server log);
# production refuses to send codes without a provider.
SMS_PROVIDER=""
KAVENEGAR_API_KEY=""
# Name of an approved Kavenegar "verify lookup" template whose %token% is the code
KAVENEGAR_OTP_TEMPLATE=""
SMSIR_API_KEY=""
# SMS.ir verify template id; the template parameter must be named CODE
SMSIR_OTP_TEMPLATE_ID=""

# ── Shop: online payment (ZarinPal) ──────────────────────────────────────────
# Without a merchant id the checkout offers cash on delivery (Tehran) only.
ZARINPAL_MERCHANT_ID=""
# 1 = sandbox.zarinpal.com (testing)
ZARINPAL_SANDBOX=""

# ── Shop: shipping fees in Toman (defaults shown) ───────────────────────────
SHIPPING_TEHRAN_FEE="80000"
SHIPPING_POST_FEE="150000"
SHIPPING_FREE_OVER="3000000"
