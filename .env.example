# Database (PostgreSQL 16)
DATABASE_URL="postgresql://user:password@localhost:5432/petboss?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Object Storage (Vultr)
STORAGE_ENDPOINT="https://ewr1.vultrobjects.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="petboss-media"
STORAGE_PUBLIC_URL="https://your-cdn-url.com"

# Admin User Setup
INITIAL_ADMIN_EMAIL="admin@petbossclinic.com"
INITIAL_ADMIN_PASSWORD="super-secret-temp-password"

# Analytics (Managed via Admin Panel, but env vars can override)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
